#!@TERMUX_PREFIX@/bin/bash
set -u

readonly HKD_VERSION="0.1.1"
readonly HKD_PACKAGE="com.hokadiw.terminal"
readonly HKD_PREFIX="@TERMUX_PREFIX@"
readonly HKD_APT_URL="@HOKADIW_APT_URL@"

cyan='\033[1;36m'
green='\033[1;32m'
yellow='\033[1;33m'
red='\033[1;31m'
reset='\033[0m'

banner() {
    printf '%b\n' "${cyan}╭──────────────────────────────────────╮${reset}"
    printf '%b\n' "${cyan}│       HOKADIW Terminal v${HKD_VERSION}       │${reset}"
    printf '%b\n' "${cyan}╰──────────────────────────────────────╯${reset}"
}

show_info() {
    banner
    printf 'Application ID : %s\n' "$HKD_PACKAGE"
    printf 'PREFIX         : %s\n' "$HKD_PREFIX"
    printf 'Architecture   : %s\n' "$(uname -m 2>/dev/null || printf unknown)"
    printf 'APT repository : %s\n' "$HKD_APT_URL"
}

doctor() {
    local failed=0
    banner

    if [ "${PREFIX:-}" = "$HKD_PREFIX" ]; then
        printf '%b %s\n' "${green}[OK]${reset}" "PREFIX matches HOKADIW"
    else
        printf '%b %s\n' "${red}[FAIL]${reset}" "PREFIX is '${PREFIX:-unset}'"
        failed=1
    fi

    if [ -w "${HOME:-/nonexistent}" ]; then
        printf '%b %s\n' "${green}[OK]${reset}" "HOME is writable"
    else
        printf '%b %s\n' "${red}[FAIL]${reset}" "HOME is not writable"
        failed=1
    fi

    if command -v apt >/dev/null 2>&1; then
        printf '%b %s\n' "${green}[OK]${reset}" "apt is installed"
    else
        printf '%b %s\n' "${red}[FAIL]${reset}" "apt is missing"
        failed=1
    fi

    if grep -RqsF "$HKD_APT_URL" "$HKD_PREFIX/etc/apt" 2>/dev/null; then
        printf '%b %s\n' "${green}[OK]${reset}" "HOKADIW APT source is configured"
    else
        printf '%b %s\n' "${yellow}[WARN]${reset}" "HOKADIW APT source was not found"
    fi

    return "$failed"
}

show_repo() {
    printf '%s\n' "$HKD_APT_URL"
    if [ -d "$HKD_PREFIX/etc/apt" ]; then
        grep -RhsE '^[[:space:]]*deb[[:space:]]' "$HKD_PREFIX/etc/apt" 2>/dev/null || true
    fi
}

update_system() {
    printf '%b\n' "${yellow}Updating HOKADIW packages...${reset}"
    apt update
    apt upgrade
}

usage() {
    cat <<'EOF'
Usage: hkd <command>

Commands:
  info      Show HOKADIW identity and runtime paths
  doctor    Check the local HOKADIW runtime
  repo      Show configured APT repository information
  update    Update installed packages
  version   Print the HOKADIW tools version
  help      Show this help
EOF
}

case "${1:-info}" in
    info) show_info ;;
    doctor) doctor ;;
    repo) show_repo ;;
    update) update_system ;;
    version|--version|-V) printf '%s\n' "$HKD_VERSION" ;;
    help|--help|-h) usage ;;
    *)
        printf '%b Unknown command: %s\n' "${red}[ERROR]${reset}" "$1" >&2
        usage >&2
        exit 2
        ;;
esac
