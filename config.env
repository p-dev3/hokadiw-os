# HOKADIW distribution identity.
HOKADIW_VERSION="0.1.4"
HOKADIW_NAME="HOKADIW"
HOKADIW_APP_NAME="HOKADIW Terminal"
# Keep the Android application id the same byte length as com.termux so native
# payloads remain patchable when compatibility rewriting is ever required.
HOKADIW_PACKAGE="io.hokadiw"
HOKADIW_GITHUB_OWNER="p-dev3"
HOKADIW_GITHUB_REPO="hokadiw-os"
# Flat APT repository published by CI under docs/apt. raw.githubusercontent.com
# works without requiring GitHub Pages to be enabled.
HOKADIW_APT_URL="https://raw.githubusercontent.com/p-dev3/hokadiw-os/main/docs/apt"

# Pinned upstream revisions for repeatable builds.
TERMUX_PACKAGES_REF="bd9b6498a9142b9940de83b491ed6fe85afb0acf"
TERMUX_APP_REF="3df69d1da197dd9bd71a3bafd902dffd720576b4"

# v0.1.4 target.
HOKADIW_ARCH="aarch64"
HOKADIW_ANDROID_ABI="arm64-v8a"
