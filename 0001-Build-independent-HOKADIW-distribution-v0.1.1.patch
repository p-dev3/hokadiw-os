+TERMUX_PKG_HOMEPAGE=https://github.com/p-dev3/hokadiw-os
+TERMUX_PKG_DESCRIPTION="HOKADIW distribution identity and maintenance command"
+TERMUX_PKG_LICENSE="MIT"
+TERMUX_PKG_LICENSE_FILE="LICENSE"
+TERMUX_PKG_MAINTAINER="HOKADIW"
+TERMUX_PKG_VERSION="0.1.1"
+TERMUX_PKG_AUTO_UPDATE=false
+TERMUX_PKG_SKIP_SRC_EXTRACT=true
+TERMUX_PKG_PLATFORM_INDEPENDENT=true
+TERMUX_PKG_DEPENDS="bash, coreutils"
+
+termux_step_make_install() {
+	local hkd="$TERMUX_PREFIX/bin/hkd"
+
+	mkdir -p "$TERMUX_PREFIX/bin" "$TERMUX_PREFIX/etc" \
+		"$TERMUX_PREFIX/share/doc/hokadiw-tools"
+
+	sed \
+		-e "s|@TERMUX_PREFIX@|$TERMUX_PREFIX|g" \
+		-e "s|@HOKADIW_APT_URL@|https://p-dev3.github.io/hokadiw-os/apt|g" \
+		"$TERMUX_PKG_BUILDER_DIR/hkd.in" > "$hkd"
+	chmod 700 "$hkd"
+
+	cat > "$TERMUX_PREFIX/etc/hokadiw-release" <<- EOF
+	NAME="HOKADIW Terminal"
+	VERSION="0.1.1"
+	ID="hokadiw"
+	ANDROID_APPLICATION_ID="com.hokadiw.terminal"
+	PREFIX="$TERMUX_PREFIX"
+	APT_URL="https://p-dev3.github.io/hokadiw-os/apt"
+	EOF
+
+	install -Dm600 "$TERMUX_PKG_BUILDER_DIR/LICENSE" \
+		"$TERMUX_PREFIX/share/doc/hokadiw-tools/LICENSE"
+}
diff --git a/packages/hokadiw-tools/hkd.in b/packages/hokadiw-tools/hkd.in
new file mode 100755
index 0000000..b4898d4
--- /dev/null
+++ b/packages/hokadiw-tools/hkd.in
@@ -0,0 +1,102 @@
+#!@TERMUX_PREFIX@/bin/bash
+set -u
+
+readonly HKD_VERSION="0.1.1"
+readonly HKD_PACKAGE="com.hokadiw.terminal"
+readonly HKD_PREFIX="@TERMUX_PREFIX@"
+readonly HKD_APT_URL="@HOKADIW_APT_URL@"
+
+cyan='\033[1;36m'
+green='\033[1;32m'
+yellow='\033[1;33m'
+red='\033[1;31m'
+reset='\033[0m'
+
+banner() {
+    printf '%b\n' "${cyan}╭──────────────────────────────────────╮${reset}"
+    printf '%b\n' "${cyan}│       HOKADIW Terminal v${HKD_VERSION}       │${reset}"
+    printf '%b\n' "${cyan}╰──────────────────────────────────────╯${reset}"
+}
+
+show_info() {
+    banner
+    printf 'Application ID : %s\n' "$HKD_PACKAGE"
+    printf 'PREFIX         : %s\n' "$HKD_PREFIX"
+    printf 'Architecture   : %s\n' "$(uname -m 2>/dev/null || printf unknown)"
+    printf 'APT repository : %s\n' "$HKD_APT_URL"
+}
+
+doctor() {
+    local failed=0
+    banner
+
+    if [ "${PREFIX:-}" = "$HKD_PREFIX" ]; then
+        printf '%b %s\n' "${green}[OK]${reset}" "PREFIX matches HOKADIW"
+    else
+        printf '%b %s\n' "${red}[FAIL]${reset}" "PREFIX is '${PREFIX:-unset}'"
+        failed=1
+    fi
+
+    if [ -w "${HOME:-/nonexistent}" ]; then
+        printf '%b %s\n' "${green}[OK]${reset}" "HOME is writable"
+    else
+        printf '%b %s\n' "${red}[FAIL]${reset}" "HOME is not writable"
+        failed=1
+    fi
+
+    if command -v apt >/dev/null 2>&1; then
+        printf '%b %s\n' "${green}[OK]${reset}" "apt is installed"
+    else
+        printf '%b %s\n' "${red}[FAIL]${reset}" "apt is missing"
+        failed=1
+    fi
+
+    if grep -RqsF "$HKD_APT_URL" "$HKD_PREFIX/etc/apt" 2>/dev/null; then
+        printf '%b %s\n' "${green}[OK]${reset}" "HOKADIW APT source is configured"
+    else
+        printf '%b %s\n' "${yellow}[WARN]${reset}" "HOKADIW APT source was not found"
+    fi
+
+    return "$failed"
+}
+
+show_repo() {
+    printf '%s\n' "$HKD_APT_URL"
+    if [ -d "$HKD_PREFIX/etc/apt" ]; then
+        grep -RhsE '^[[:space:]]*deb[[:space:]]' "$HKD_PREFIX/etc/apt" 2>/dev/null || true
+    fi
+}
+
+update_system() {
+    printf '%b\n' "${yellow}Updating HOKADIW packages...${reset}"
+    apt update
+    apt upgrade
+}
+
+usage() {
+    cat <<'EOF'
+Usage: hkd <command>
+
+Commands:
+  info      Show HOKADIW identity and runtime paths
+  doctor    Check the local HOKADIW runtime
+  repo      Show configured APT repository information
+  update    Update installed packages
+  version   Print the HOKADIW tools version
+  help      Show this help
+EOF
+}
+
+case "${1:-info}" in
+    info) show_info ;;
+    doctor) doctor ;;
+    repo) show_repo ;;
+    update) update_system ;;
+    version|--version|-V) printf '%s\n' "$HKD_VERSION" ;;
+    help|--help|-h) usage ;;
+    *)
+        printf '%b Unknown command: %s\n' "${red}[ERROR]${reset}" "$1" >&2
+        usage >&2
+        exit 2
+        ;;
+esac
