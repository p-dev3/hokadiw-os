#!/data/data/com.termux/files/usr/bin/bash

# HOKADIW Terminal dashboard
# Phase 1: keep com.termux/PREFIX compatibility, provide helper commands separately.

set -u

ESC=$'\033'
C_RESET="${ESC}[0m"
C_BOLD="${ESC}[1m"
C_CYAN="${ESC}[96m"
C_MAGENTA="${ESC}[95m"
C_GREEN="${ESC}[92m"
C_YELLOW="${ESC}[93m"
C_RED="${ESC}[91m"

HKD_HOME="${HKD_HOME:-$HOME/.local/share/hokadiw-os-toolkit}"

pause() {
  printf "\n${C_YELLOW}Press Enter to continue...${C_RESET}"
  read -r _
}

header() {
  clear
  printf "${C_MAGENTA}${C_BOLD}"
  cat <<'EOF'
██╗  ██╗ ██████╗ ██╗  ██╗ █████╗ ██████╗ ██╗██╗    ██╗
██║  ██║██╔═══██╗██║ ██╔╝██╔══██╗██╔══██╗██║██║    ██║
███████║██║   ██║█████╔╝ ███████║██║  ██║██║██║ █╗ ██║
██╔══██║██║   ██║██╔═██╗ ██╔══██║██║  ██║██║██║███╗██║
██║  ██║╚██████╔╝██║  ██╗██║  ██║██████╔╝██║╚███╔███╔╝
╚═╝  ╚═╝ ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝╚═════╝ ╚═╝ ╚══╝╚══╝
EOF
  printf "${C_RESET}${C_CYAN}             HOKADIW TERMINAL • Phase 1${C_RESET}\n\n"
}

have() {
  command -v "$1" >/dev/null 2>&1
}

ensure_pkg() {
  local command_name="$1"
  local package_name="$2"

  if have "$command_name"; then
    return 0
  fi

  printf "${C_YELLOW}%s is not installed. Install package '%s'? [Y/n] ${C_RESET}" "$command_name" "$package_name"
  read -r answer
  case "${answer:-Y}" in
    y|Y|yes|YES)
      pkg install -y "$package_name"
      ;;
    *)
      return 1
      ;;
  esac
}

system_info() {
  header
  printf "${C_GREEN}[ System ]${C_RESET}\n"
  printf "Android : %s\n" "$(getprop ro.build.version.release 2>/dev/null || true)"
  printf "SDK     : %s\n" "$(getprop ro.build.version.sdk 2>/dev/null || true)"
  printf "Device  : %s %s\n" "$(getprop ro.product.manufacturer 2>/dev/null || true)" "$(getprop ro.product.model 2>/dev/null || true)"
  printf "ABI     : %s\n" "$(getprop ro.product.cpu.abi 2>/dev/null || uname -m)"
  printf "Kernel  : %s\n" "$(uname -srmo 2>/dev/null || uname -a)"
  printf "PREFIX  : %s\n" "${PREFIX:-<unset>}"
  printf "HOME    : %s\n" "$HOME"
  printf "\n"
  df -h "${PREFIX:-$HOME}" 2>/dev/null | tail -n +1
  pause
}

adb_menu() {
  while true; do
    header
    printf "${C_GREEN}[ ADB / Shizuku ]${C_RESET}\n"
    printf "1. Install/check android-tools\n"
    printf "2. adb devices -l\n"
    printf "3. Pair Wireless debugging\n"
    printf "4. Connect to ADB endpoint\n"
    printf "5. Switch adbd to TCP port 5555\n"
    printf "6. Connect localhost:5555\n"
    printf "7. Start Shizuku through ADB\n"
    printf "8. Kill local ADB server\n"
    printf "0. Back\n\n"
    printf "${C_CYAN}> ${C_RESET}"
    read -r choice

    case "$choice" in
      1)
        ensure_pkg adb android-tools || true
        pause
        ;;
      2)
        ensure_pkg adb android-tools && adb devices -l
        pause
        ;;
      3)
        ensure_pkg adb android-tools || { pause; continue; }
        printf "Pair endpoint (example 127.0.0.1:37123): "
        read -r endpoint
        printf "Pairing code: "
        read -r code
        adb pair "$endpoint" "$code"
        pause
        ;;
      4)
        ensure_pkg adb android-tools || { pause; continue; }
        printf "ADB endpoint (example 127.0.0.1:40555): "
        read -r endpoint
        adb connect "$endpoint"
        pause
        ;;
      5)
        ensure_pkg adb android-tools || { pause; continue; }
        printf "${C_RED}Warning:${C_RESET} TCP ADB can expose adbd on network interfaces.\n"
        printf "Only do this on a trusted network. Continue? [y/N] "
        read -r answer
        case "$answer" in
          y|Y|yes|YES) adb tcpip 5555 ;;
          *) printf "Cancelled.\n" ;;
        esac
        pause
        ;;
      6)
        ensure_pkg adb android-tools && adb connect 127.0.0.1:5555
        pause
        ;;
      7)
        ensure_pkg adb android-tools || { pause; continue; }
        adb shell sh /sdcard/Android/data/moe.shizuku.privileged.api/start.sh
        pause
        ;;
      8)
        ensure_pkg adb android-tools && adb kill-server
        pause
        ;;
      0) return ;;
      *) ;;
    esac
  done
}

vpn_menu() {
  while true; do
    header
    printf "${C_GREEN}[ VPN tools ]${C_RESET}\n"
    printf "1. Show network interfaces\n"
    printf "2. Show routes\n"
    printf "3. Install/check WireGuard tools\n"
    printf "4. wg show\n"
    printf "0. Back\n\n"
    printf "${C_CYAN}> ${C_RESET}"
    read -r choice

    case "$choice" in
      1)
        ip -brief addr 2>/dev/null || ip addr
        pause
        ;;
      2)
        ip route 2>/dev/null || true
        pause
        ;;
      3)
        ensure_pkg wg wireguard-tools || true
        pause
        ;;
      4)
        if ensure_pkg wg wireguard-tools; then
          wg show || printf "${C_YELLOW}WireGuard interface information may require privileges/support from the active VPN implementation.${C_RESET}\n"
        fi
        pause
        ;;
      0) return ;;
      *) ;;
    esac
  done
}

vps_menu() {
  while true; do
    header
    printf "${C_GREEN}[ VPS / SSH ]${C_RESET}\n"
    printf "1. Install/check OpenSSH\n"
    printf "2. Connect to VPS\n"
    printf "3. Show SSH public key\n"
    printf "4. Generate ed25519 SSH key\n"
    printf "0. Back\n\n"
    printf "${C_CYAN}> ${C_RESET}"
    read -r choice

    case "$choice" in
      1)
        ensure_pkg ssh openssh || true
        pause
        ;;
      2)
        ensure_pkg ssh openssh || { pause; continue; }
        printf "User@host: "
        read -r target
        printf "Port [22]: "
        read -r port
        port="${port:-22}"
        ssh -p "$port" "$target"
        pause
        ;;
      3)
        if [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
          cat "$HOME/.ssh/id_ed25519.pub"
        elif [ -f "$HOME/.ssh/id_rsa.pub" ]; then
          cat "$HOME/.ssh/id_rsa.pub"
        else
          printf "${C_YELLOW}No default SSH public key found.${C_RESET}\n"
        fi
        pause
        ;;
      4)
        ensure_pkg ssh-keygen openssh || { pause; continue; }
        mkdir -p "$HOME/.ssh"
        if [ -e "$HOME/.ssh/id_ed25519" ]; then
          printf "${C_YELLOW}$HOME/.ssh/id_ed25519 already exists; not overwriting it.${C_RESET}\n"
        else
          ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519"
        fi
        pause
        ;;
      0) return ;;
      *) ;;
    esac
  done
}

update_hkd() {
  header
  printf "${C_GREEN}[ Update HOKADIW toolkit ]${C_RESET}\n"
  if [ -d "$HKD_HOME/.git" ]; then
    git -C "$HKD_HOME" pull --ff-only &&
      bash "$HKD_HOME/install.sh"
  else
    printf "${C_YELLOW}No managed Git checkout found at:${C_RESET}\n%s\n" "$HKD_HOME"
    printf "Clone the repository there, then run install.sh.\n"
  fi
  pause
}

main_menu() {
  while true; do
    header
    printf "1. System information\n"
    printf "2. ADB / Shizuku\n"
    printf "3. VPN tools\n"
    printf "4. VPS / SSH\n"
    printf "5. Update HOKADIW toolkit\n"
    printf "0. Exit\n\n"
    printf "${C_CYAN}> ${C_RESET}"
    read -r choice

    case "$choice" in
      1) system_info ;;
      2) adb_menu ;;
      3) vpn_menu ;;
      4) vps_menu ;;
      5) update_hkd ;;
      0) clear; return ;;
      *) ;;
    esac
  done
}

main_menu
